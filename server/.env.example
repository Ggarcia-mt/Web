# Copia este archivo como server/.env y ajusta los valores.

# --- Base de datos PostgreSQL ---
# Local con `npm run db:local`:
DATABASE_URL="postgresql://campuspoli:campuspoli@localhost:5433/campuspoli"
# Nube (Neon, Supabase, Render): pega aquí la cadena de conexión que te dan.

# --- Servidor ---
PORT=4000
NODE_ENV=development
# URL pública del frontend (se usa en los QR y en los enlaces de evaluaciones públicas)
APP_URL=http://localhost:5173
# Solo si el frontend está en otro dominio (separados por coma)
CORS_ORIGINS=

# --- Seguridad (RNF-03) ---
# Genera uno largo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
SESSION_IDLE_MINUTES=30

# --- Calificación ---
GRADE_SCALE=5
PASSING_GRADE=3

# --- Administrador inicial (npm run db:seed) ---
ADMIN_EMAIL=admin@campuspoli.edu.co
ADMIN_PASSWORD=Admin12345
# SEED_DEMO=true crea profesor, estudiantes y un curso de ejemplo
SEED_DEMO=false

# --- Proveedores de IA (configura al menos uno) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cualquier API compatible con OpenAI (DeepSeek, Groq, OpenRouter, Ollama local...)
OPENAI_COMPAT_NAME=DeepSeek
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
